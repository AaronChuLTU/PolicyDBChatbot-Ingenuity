# Copy to .env and fill in the values below.

# Required — shared secret the frontend must send as X-API-Key.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# You can just use the pre-existing one
API_KEY=

# Comma-separated list of frontend origins allowed to call this API.
# Add your Cloudflare tunnel URL here when demoing.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional — only needed if your Postgres isn't on localhost with defaults.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=policydb
# PGUSER=postgres
# PGPASSWORD=postgres

# Optional — only needed if Ollama isn't on localhost with defaults.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3
# OLLAMA_TIMEOUT=60

# Optional — port the backend listens on.
# PORT=8000