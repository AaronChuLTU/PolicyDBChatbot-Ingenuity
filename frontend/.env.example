# Copy to .env and fill in the values below.

# Required — the backend's URL. Use http://localhost:8000 for local dev,
# or your Cloudflare tunnel URL when demoing (see root README's
# "Demo Hosting" section).
VITE_API_BASE_URL=http://localhost:8000

# Required — must exactly match API_KEY in backend/.env, sent as the
# X-API-Key header on every request. Ask a teammate for the value, or
# generate a new one together and update both .env files.
VITE_API_KEY=